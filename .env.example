# Copy to .env and fill in whichever providers you use.
# You do NOT need all of these — the platform works with zero, one, or all.
# With zero keys set, the dashboard still runs fully in deterministic mode
# (GRS scoring, attack-path graph, findings table) — only the AI narrative/
# chat/remediation-enrichment layers require at least one key.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
